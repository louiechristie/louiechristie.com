<script eleventy:ignore>

    const now = new Date();
    const month = now.getMonth() + 1; // 1–12
    const day = now.getDate();

    const isChristmasSeason =
      (month === 11 && day >= 21) ||
      (month === 12) || (month === 1 && day <= 5);

    if (surf && isChristmasSeason) {
      document.getElementById("surf").innerHTML = 
      [
        `<figure class="image-container">`,
        `    <a id="adventure-link" href="adventure/">`,
        `       <img `, `id="surf-image"`, `           src="/images/louie_christie_surfing_as_father_christmas.JPG"`, `           alt="Louie Christie dressed as Father Christmas in a Santa suit surfing"`, `           title="After this, sadly Santa was mauled to death in a shark attack."`, `           style="aspect-ratio: 16 / 9" />`,
        `</a>`,
        `    <figcaption style="text-decoration: none;">`,
        `        <small id="surf-caption">Surfing, Christmas Day 2018 @ Bondi Beach</small>`,
        `    </figcaption>`,
        `</figure>`
      ].join("");
    }
</script>
